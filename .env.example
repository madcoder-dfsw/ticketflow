# Core Django
DJANGO_SECRET_KEY=replace-with-strong-random-50-char-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Managed PostgreSQL (e.g., Neon, Supabase, Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# S3-Compatible Object Storage (Cloudflare R2, AWS S3, Backblaze B2)
USE_S3_STORAGE=True
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=ticketflow-attachments
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto

# Bonus AI Admin Assistant (Groq / OpenAI-compatible free tier)
LLM_API_KEY=your-free-tier-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant